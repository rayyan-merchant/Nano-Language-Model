{
  "entrypoint": "python -m nano_lm.train",
  "arguments": [
    "--root",
    "/tmp/nano-source",
    "--dataset",
    "/tmp/pilot-data",
    "--experiment",
    "E06",
    "--seed",
    "42",
    "--steps",
    "5000",
    "--device",
    "cuda",
    "--precision",
    "float32",
    "--run-kind",
    "research",
    "--tokens-per-update",
    "4096",
    "--micro-batch-size",
    "4",
    "--optimizer",
    "AdamW",
    "--learning-rate",
    "0.0003",
    "--weight-decay",
    "0.01",
    "--gradient-clip",
    "1.0",
    "--eval-every",
    "250",
    "--checkpoint-every",
    "500",
    "--conditioning-bytes",
    "256",
    "--eval-max-bytes",
    "0",
    "--eval-mode",
    "sliding",
    "--eval-batch-size",
    "32",
    "--output",
    "/kaggle/working/pilot/runs",
    "--export-root",
    "/kaggle/working/pilot/snapshots"
  ],
  "timing_hooks": "checkpoint/export/journal calls only; original arguments and return values preserved"
}
