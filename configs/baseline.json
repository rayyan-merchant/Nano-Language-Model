{
  "model": {
    "d_model": 192,
    "n_heads": 6,
    "n_layers": 4,
    "context_length": 128,
    "mlp_expansion": 4,
    "activation": "gelu",
    "position": "sinusoidal",
    "dropout": 0.1
  },
  "training": {
    "dataset": "tiny_shakespeare",
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "optimizer_steps": 5000,
    "seeds": [
      42,
      123,
      456
    ],
    "target_tokens_per_update": 4096,
    "weight_decay": 0.01,
    "scheduler": "constant",
    "precision": "float32",
    "gradient_clip_norm": 1.0,
    "tokenizer": "character"
  }
}
